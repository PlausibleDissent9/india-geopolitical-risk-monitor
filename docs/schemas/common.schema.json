{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://igrm.in/schemas/common.schema.json",
  "title": "IGRM canonical object common definitions",
  "$defs": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utcDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "nullableDate": {
      "oneOf": [
        {"$ref": "#/$defs/date"},
        {"type": "null"}
      ]
    },
    "nullableDateTime": {
      "oneOf": [
        {"$ref": "#/$defs/utcDateTime"},
        {"type": "null"}
      ]
    },
    "nullableId": {
      "oneOf": [
        {"$ref": "#/$defs/stableId"},
        {"type": "null"}
      ]
    },
    "nullableSha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "idArray": {
      "type": "array",
      "items": {"$ref": "#/$defs/stableId"},
      "uniqueItems": true
    },
    "nonEmptyIdArray": {
      "allOf": [
        {"$ref": "#/$defs/idArray"},
        {"minItems": 1}
      ]
    },
    "recordState": {
      "type": "string",
      "enum": ["active", "superseded", "withdrawn"]
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "meaning", "lower", "upper", "category"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["interval", "categorical", "not_estimated", "not_applicable"]
        },
        "meaning": {"type": "string", "minLength": 1, "maxLength": 500},
        "lower": {"type": ["number", "null"]},
        "upper": {"type": ["number", "null"]},
        "category": {"type": ["string", "null"], "minLength": 1, "maxLength": 120}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "interval"}}},
          "then": {
            "properties": {
              "lower": {"type": "number"},
              "upper": {"type": "number"},
              "category": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "categorical"}}},
          "then": {
            "properties": {
              "lower": {"type": "null"},
              "upper": {"type": "null"},
              "category": {"type": "string"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {"enum": ["not_estimated", "not_applicable"]}
            }
          },
          "then": {
            "properties": {
              "lower": {"type": "null"},
              "upper": {"type": "null"},
              "category": {"type": "null"}
            }
          }
        }
      ]
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "denominator",
        "period_start",
        "period_end",
        "currency",
        "price_basis",
        "uncertainty"
      ],
      "properties": {
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1, "maxLength": 120},
        "denominator": {"type": "string", "minLength": 1, "maxLength": 300},
        "period_start": {"$ref": "#/$defs/nullableDate"},
        "period_end": {"$ref": "#/$defs/nullableDate"},
        "currency": {
          "oneOf": [
            {"type": "string", "pattern": "^[A-Z]{3}$"},
            {"type": "null"}
          ]
        },
        "price_basis": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
        "uncertainty": {"$ref": "#/$defs/uncertainty"}
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method_id", "version", "implementation_sha256", "run_id"],
      "properties": {
        "method_id": {"$ref": "#/$defs/stableId"},
        "version": {"$ref": "#/$defs/schemaVersion"},
        "implementation_sha256": {"$ref": "#/$defs/sha256"},
        "run_id": {"$ref": "#/$defs/stableId"}
      }
    },
    "recordLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "state", "supersedes_id", "superseded_by", "correction_id"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "state": {"$ref": "#/$defs/recordState"},
        "supersedes_id": {"$ref": "#/$defs/nullableId"},
        "superseded_by": {"$ref": "#/$defs/nullableId"},
        "correction_id": {"$ref": "#/$defs/nullableId"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "created_by",
        "reviewed_by",
        "adjudication_status",
        "source_ids",
        "evidence_ids",
        "method"
      ],
      "properties": {
        "created_at": {"$ref": "#/$defs/utcDateTime"},
        "created_by": {"$ref": "#/$defs/stableId"},
        "reviewed_by": {"$ref": "#/$defs/idArray"},
        "adjudication_status": {
          "type": "string",
          "enum": ["unreviewed", "single_reviewed", "dual_reviewed", "adjudicated", "disputed"]
        },
        "source_ids": {"$ref": "#/$defs/nonEmptyIdArray"},
        "evidence_ids": {"$ref": "#/$defs/idArray"},
        "method": {
          "oneOf": [
            {"$ref": "#/$defs/method"},
            {"type": "null"}
          ]
        }
      }
    }
  }
}
