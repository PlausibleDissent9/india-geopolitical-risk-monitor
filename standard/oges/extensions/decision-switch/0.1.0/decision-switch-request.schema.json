{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://igrm.in/oges/extensions/decision-switch/0.1.0/decision-switch-request.schema.json",
  "title": "OGES Decision Switch finite-lattice request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type", "schema_version", "record_sha256", "decision_case_id",
    "created_at", "evaluation_as_of", "release", "knowledge_cutoff",
    "event_id", "target_entity_id", "options", "constraint_slots", "atoms",
    "variants", "information_candidates", "guardrails", "limitations"
  ],
  "properties": {
    "object_type": {"const": "decision_switch_request"},
    "schema_version": {"const": "0.1.0"},
    "record_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
    "decision_case_id": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/stableId"},
    "created_at": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/utcDateTime"},
    "evaluation_as_of": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/utcDateTime"},
    "release": {"$ref": "#/$defs/release"},
    "knowledge_cutoff": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/utcDateTime"},
    "event_id": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/stableId"},
    "target_entity_id": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/stableId"},
    "options": {
      "type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true,
      "items": {"$ref": "https://igrm.in/oges/extensions/decision-switch/0.1.0/registered-option.schema.json"}
    },
    "constraint_slots": {
      "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
      "items": {"$ref": "https://igrm.in/oges/extensions/decision-switch/0.1.0/constraint-slot.schema.json"}
    },
    "atoms": {
      "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true,
      "items": {"$ref": "https://igrm.in/oges/extensions/decision-switch/0.1.0/switch-atom.schema.json"}
    },
    "variants": {
      "type": "array", "minItems": 2, "maxItems": 64, "uniqueItems": true,
      "items": {"$ref": "#/$defs/variant"}
    },
    "information_candidates": {
      "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
      "items": {"$ref": "https://igrm.in/oges/extensions/decision-switch/0.1.0/information-candidate.schema.json"}
    },
    "guardrails": {"$ref": "#/$defs/guardrails"},
    "limitations": {
      "allOf": [
        {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/nonEmptyIdArray"},
        {"contains": {"const": "registered_binary_lattice_not_real_world_state_space"}},
        {"contains": {"const": "robust_option_set_not_real_world_feasibility_or_advice"}},
        {"contains": {"const": "minimal_switches_only_within_registered_lattice"}},
        {"contains": {"const": "information_relevance_is_set_reduction_not_expected_value_entropy_or_probability"}},
        {"contains": {"const": "no_forecast_recommendation_optimization_or_purchase_decision"}},
        {"contains": {"const": "non_synthetic_rendering_requires_claim_bundle"}}
      ]
    }
  },
  "$defs": {
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["release_id", "record_sha256", "generated_at", "effective_date"],
      "properties": {
        "release_id": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/stableId"},
        "record_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
        "generated_at": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/utcDateTime"},
        "effective_date": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/date"}
      }
    },
    "variant": {
      "type": "object", "additionalProperties": false,
      "required": ["variant_id", "active_atom_ids", "bundles"],
      "properties": {
        "variant_id": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/stableId"},
        "active_atom_ids": {
          "type": "array", "minItems": 0, "maxItems": 6, "uniqueItems": true,
          "items": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/stableId"}
        },
        "bundles": {
          "type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true,
          "items": {"$ref": "https://igrm.in/oges/extensions/decision-switch/0.1.0/decision-artifact-bundle.schema.json"}
        }
      }
    },
    "guardrails": {
      "type": "object", "additionalProperties": false,
      "required": [
        "real_world_feasibility_claimed", "joint_feasibility_claimed",
        "causal_attribution_performed", "forecast_performed",
        "probability_assigned", "entropy_computed", "expected_value_computed",
        "recommendation_generated", "objective_optimized",
        "purchase_recommended", "candidate_set_completeness_claimed",
        "global_minimality_claimed"
      ],
      "properties": {
        "real_world_feasibility_claimed": {"const": false},
        "joint_feasibility_claimed": {"const": false},
        "causal_attribution_performed": {"const": false},
        "forecast_performed": {"const": false},
        "probability_assigned": {"const": false},
        "entropy_computed": {"const": false},
        "expected_value_computed": {"const": false},
        "recommendation_generated": {"const": false},
        "objective_optimized": {"const": false},
        "purchase_recommended": {"const": false},
        "candidate_set_completeness_claimed": {"const": false},
        "global_minimality_claimed": {"const": false}
      }
    }
  }
}
