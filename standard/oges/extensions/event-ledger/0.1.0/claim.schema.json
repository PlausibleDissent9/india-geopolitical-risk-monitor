{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://igrm.in/schemas/oges-event-ledger-claim-0.1.0.json",
  "title": "OGES Event Ledger Claim extension object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "claim_id",
    "record_sha256",
    "revision",
    "supersedes_claim_id",
    "assertion_state",
    "subject_event",
    "valid_from",
    "valid_to",
    "known_at",
    "created_by",
    "evidence_links",
    "event_state_effect"
  ],
  "properties": {
    "object_type": {"const": "claim"},
    "schema_version": {"const": "0.1.0"},
    "claim_id": {"type": "string", "pattern": "^clm:[a-z0-9][a-z0-9._:-]{2,123}$"},
    "record_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
    "revision": {"type": "integer", "minimum": 1},
    "supersedes_claim_id": {
      "oneOf": [
        {"type": "string", "pattern": "^clm:[a-z0-9][a-z0-9._:-]{2,123}$"},
        {"type": "null"}
      ]
    },
    "assertion_state": {
      "enum": [
        "allegation",
        "coded_inference",
        "official_confirmation",
        "observed_disruption",
        "disputed",
        "superseded"
      ]
    },
    "subject_event": {"$ref": "#/$defs/eventRef"},
    "valid_from": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/utcDateTime"},
    "valid_to": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/nullableDateTime"},
    "known_at": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/utcDateTime"},
    "created_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "authority_id"],
      "properties": {
        "kind": {"enum": ["model", "registered_deterministic_method", "human"]},
        "authority_id": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/stableId"}
      }
    },
    "evidence_links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "evidence_record_sha256", "role", "asserted_at"],
        "properties": {
          "evidence_id": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/stableId"},
          "evidence_record_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
          "role": {
            "enum": [
              "allegation",
              "supports_inference",
              "official_confirmation",
              "observed_disruption",
              "corroborates",
              "contradicts",
              "correction",
              "context"
            ]
          },
          "asserted_at": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/utcDateTime"}
        }
      }
    },
    "event_state_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "from_event",
        "to_event",
        "target_record_status",
        "authority_kind",
        "authority_id"
      ],
      "properties": {
        "kind": {"enum": ["none", "promotion"]},
        "from_event": {"oneOf": [{"$ref": "#/$defs/eventRef"}, {"type": "null"}]},
        "to_event": {"oneOf": [{"$ref": "#/$defs/eventRef"}, {"type": "null"}]},
        "target_record_status": {
          "type": ["string", "null"],
          "enum": [null, "candidate", "confirmed", "disputed", "withdrawn"]
        },
        "authority_kind": {
          "type": ["string", "null"],
          "enum": [null, "registered_evidence_rule", "named_human_authority"]
        },
        "authority_id": {
          "oneOf": [
            {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/stableId"},
            {"type": "null"}
          ]
        }
      }
    }
  },
  "$defs": {
    "eventRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "record_sha256"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^evt:[a-z0-9][a-z0-9._:-]{2,123}$"},
        "record_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"}
      }
    }
  }
}
