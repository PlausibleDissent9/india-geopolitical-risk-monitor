{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://igrm.in/oges/extensions/mechanism-constraint-scenario/0.1.0/scenario-proof-execution.schema.json",
  "title": "OGES bounded scenario-proof execution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type", "schema_version", "record_sha256", "execution_id",
    "profile", "request", "compilation", "constraints", "hypotheses",
    "counts", "result", "limitations"
  ],
  "properties": {
    "object_type": {"const": "scenario_proof_execution"},
    "schema_version": {"const": "0.1.0"},
    "record_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
    "execution_id": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/stableId"},
    "profile": {"$ref": "#/$defs/profile"},
    "request": {"$ref": "#/$defs/request"},
    "compilation": {"$ref": "#/$defs/compilation"},
    "constraints": {
      "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
      "items": {"$ref": "#/$defs/constraintResult"}
    },
    "hypotheses": {
      "type": "array", "minItems": 2, "maxItems": 20, "uniqueItems": true,
      "items": {"$ref": "#/$defs/hypothesisResult"}
    },
    "counts": {"$ref": "#/$defs/counts"},
    "result": {"$ref": "#/$defs/result"},
    "limitations": {
      "allOf": [
        {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/nonEmptyIdArray"},
        {"contains": {"const": "constraint_status_applies_only_to_registered_hypothetical_bounds"}},
        {"contains": {"const": "mechanism_status_is_not_support_confirmation_or_causality"}},
        {"contains": {"const": "interval_corners_are_not_probabilities_or_confidence_intervals"}},
        {"contains": {"const": "no_real_world_feasibility_forecast_advice_or_optimization"}},
        {"contains": {"const": "non_synthetic_rendering_requires_claim_bundle"}}
      ]
    }
  },
  "$defs": {
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": [
        "extension_id", "version", "profile_sha256", "request_schema_sha256",
        "execution_schema_sha256", "constraint_schema_sha256",
        "hypothesis_schema_sha256", "operator_registry_sha256",
        "predicate_registry_sha256", "shock_registry_sha256",
        "shock_compiler_sha256", "reference_implementation_sha256"
      ],
      "properties": {
        "extension_id": {"const": "oges:extension:scenario_proof"},
        "version": {"const": "0.1.0"},
        "profile_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
        "request_schema_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
        "execution_schema_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
        "constraint_schema_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
        "hypothesis_schema_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
        "operator_registry_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
        "predicate_registry_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
        "shock_registry_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
        "shock_compiler_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
        "reference_implementation_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"}
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "record_sha256", "created_at", "evaluation_as_of"],
      "properties": {
        "request_id": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/stableId"},
        "record_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
        "created_at": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/utcDateTime"},
        "evaluation_as_of": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/utcDateTime"}
      }
    },
    "compilation": {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "scenario_record_sha256", "compilation_record_sha256", "release_id", "release_record_sha256"],
      "properties": {
        "scenario_id": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/stableId"},
        "scenario_record_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
        "compilation_record_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
        "release_id": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/stableId"},
        "release_record_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"}
      }
    },
    "threshold": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "unit", "denominator"],
      "properties": {
        "value": {"type": "number"},
        "unit": {"enum": ["percentage_points_of_edge_denominator", "days"]},
        "denominator": {"type": ["string", "null"], "minLength": 1, "maxLength": 300}
      }
    },
    "interval": {
      "type": "object", "additionalProperties": false,
      "required": ["lower", "upper", "unit", "denominator"],
      "properties": {
        "lower": {"type": "number"}, "upper": {"type": "number"},
        "unit": {"enum": ["percentage_points_of_edge_denominator", "days"]},
        "denominator": {"type": ["string", "null"], "minLength": 1, "maxLength": 300}
      }
    },
    "cornerInputs": {
      "type": "object", "additionalProperties": false,
      "required": ["edge_value", "shock_value", "substitution_value", "duration_value", "buffer_value"],
      "properties": {
        "edge_value": {"type": ["number", "null"]},
        "shock_value": {"type": ["number", "null"]},
        "substitution_value": {"type": ["number", "null"]},
        "duration_value": {"type": ["number", "null"]},
        "buffer_value": {"type": ["number", "null"]}
      }
    },
    "cornerWitness": {
      "type": "object", "additionalProperties": false,
      "required": ["bound", "value", "inputs", "transform_ids"],
      "properties": {
        "bound": {"enum": ["lower", "upper"]},
        "value": {"type": "number"},
        "inputs": {"$ref": "#/$defs/cornerInputs"},
        "transform_ids": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/nonEmptyIdArray"}
      }
    },
    "constraintResult": {
      "type": "object", "additionalProperties": false,
      "required": [
        "constraint_id", "constraint_record_sha256", "path_id", "metric",
        "operator", "threshold", "actual_interval", "margin_interval",
        "interval_relation", "readiness", "scenario_feasibility_status",
        "corner_witnesses", "real_world_feasibility_claimed"
      ],
      "properties": {
        "constraint_id": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/stableId"},
        "constraint_record_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
        "path_id": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/stableId"},
        "metric": {"enum": ["gross_affected_share", "residual_affected_share", "residual_duration"]},
        "operator": {"const": "upper_bound_lte"},
        "threshold": {"$ref": "#/$defs/threshold"},
        "actual_interval": {"oneOf": [{"$ref": "#/$defs/interval"}, {"type": "null"}]},
        "margin_interval": {"oneOf": [{"$ref": "#/$defs/interval"}, {"type": "null"}]},
        "interval_relation": {"enum": ["all_registered_values_satisfy", "no_registered_values_satisfy", "mixed_within_registered_interval", "not_evaluable"]},
        "readiness": {"enum": ["current_inputs", "stale_inputs", "unknown_freshness", "upstream_abstention"]},
        "scenario_feasibility_status": {"enum": ["satisfied_under_registered_hypothetical_bounds", "violated_under_registered_hypothetical_bounds", "indeterminate_within_registered_bounds", "indeterminate_input_unavailable"]},
        "corner_witnesses": {"type": "array", "minItems": 0, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/cornerWitness"}},
        "real_world_feasibility_claimed": {"const": false}
      }
    },
    "falsifierResult": {
      "type": "object", "additionalProperties": false,
      "required": ["falsifier_id", "predicate_id", "expected_value", "constraint_id", "status"],
      "properties": {
        "falsifier_id": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/stableId"},
        "predicate_id": {
          "enum": [
            "predicate:scenario.path_quantification_status_equals",
            "predicate:scenario.path_gap_code_present",
            "predicate:scenario.constraint_interval_relation_equals"
          ]
        },
        "expected_value": {"type": "string", "minLength": 1, "maxLength": 128},
        "constraint_id": {"oneOf": [{"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/stableId"}, {"type": "null"}]},
        "status": {"enum": ["triggered", "not_triggered", "not_evaluable"]}
      }
    },
    "hypothesisResult": {
      "type": "object", "additionalProperties": false,
      "required": [
        "hypothesis_id", "hypothesis_record_sha256", "path_id", "mechanism_code",
        "epistemic_status", "causal_status", "registered_at",
        "registration_timing", "rival_hypothesis_ids", "falsifiers",
        "scenario_compatibility_status", "support_claimed", "probability_assigned"
      ],
      "properties": {
        "hypothesis_id": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/stableId"},
        "hypothesis_record_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
        "path_id": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/stableId"},
        "mechanism_code": {"enum": ["registered_path_transmission_candidate", "alternative_pathway_candidate"]},
        "epistemic_status": {"const": "candidate_not_established"},
        "causal_status": {"const": "not_identified"},
        "registered_at": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/utcDateTime"},
        "registration_timing": {"enum": ["prospective", "retrospective"]},
        "rival_hypothesis_ids": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/nonEmptyIdArray"},
        "falsifiers": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"$ref": "#/$defs/falsifierResult"}},
        "scenario_compatibility_status": {"enum": ["compatible_with_compiled_scenario_not_supported", "incompatible_with_compiled_scenario_not_real_world_falsified", "indeterminate_missing_registered_result"]},
        "support_claimed": {"const": false},
        "probability_assigned": {"const": false}
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["constraints", "constraint_results", "hypotheses", "hypothesis_results", "rival_links", "falsifiers", "falsifiers_triggered", "falsifiers_unevaluable"],
      "properties": {
        "constraints": {"type": "integer", "minimum": 1},
        "constraint_results": {"type": "integer", "minimum": 1},
        "hypotheses": {"type": "integer", "minimum": 2},
        "hypothesis_results": {"type": "integer", "minimum": 2},
        "rival_links": {"type": "integer", "minimum": 2},
        "falsifiers": {"type": "integer", "minimum": 2},
        "falsifiers_triggered": {"type": "integer", "minimum": 0},
        "falsifiers_unevaluable": {"type": "integer", "minimum": 0}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "trust_class", "public_claim_state", "real_world_feasibility_claimed", "mechanism_support_claimed", "causal_attribution_performed", "forecast_performed", "probability_assigned", "recommendation_generated", "objective_optimized"],
      "properties": {
        "status": {"enum": ["assessed", "partially_assessed"]},
        "trust_class": {"const": "unauthenticated_execution_envelope"},
        "public_claim_state": {"const": "requires_claim_bundle"},
        "real_world_feasibility_claimed": {"const": false},
        "mechanism_support_claimed": {"const": false},
        "causal_attribution_performed": {"const": false},
        "forecast_performed": {"const": false},
        "probability_assigned": {"const": false},
        "recommendation_generated": {"const": false},
        "objective_optimized": {"const": false}
      }
    }
  }
}
