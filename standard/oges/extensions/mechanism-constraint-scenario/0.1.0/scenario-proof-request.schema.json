{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://igrm.in/oges/extensions/mechanism-constraint-scenario/0.1.0/scenario-proof-request.schema.json",
  "title": "OGES bounded scenario-proof request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type", "schema_version", "record_sha256", "request_id",
    "created_at", "evaluation_as_of", "scenario_binding", "constraints",
    "hypotheses", "guardrails", "limitations"
  ],
  "properties": {
    "object_type": {"const": "scenario_proof_request"},
    "schema_version": {"const": "0.1.0"},
    "record_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
    "request_id": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/stableId"},
    "created_at": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/utcDateTime"},
    "evaluation_as_of": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/utcDateTime"},
    "scenario_binding": {"$ref": "#/$defs/scenarioBinding"},
    "constraints": {
      "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
      "items": {"$ref": "https://igrm.in/oges/extensions/mechanism-constraint-scenario/0.1.0/constraint.schema.json"}
    },
    "hypotheses": {
      "type": "array", "minItems": 2, "maxItems": 20, "uniqueItems": true,
      "items": {"$ref": "https://igrm.in/oges/extensions/mechanism-constraint-scenario/0.1.0/mechanism-hypothesis.schema.json"}
    },
    "guardrails": {"$ref": "#/$defs/guardrails"},
    "limitations": {
      "allOf": [
        {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/nonEmptyIdArray"},
        {"contains": {"const": "hypothetical_scenario_feasibility_not_real_world_feasibility"}},
        {"contains": {"const": "mechanism_compatibility_not_support_or_causality"}},
        {"contains": {"const": "no_forecast_probability_recommendation_or_optimization"}},
        {"contains": {"const": "non_synthetic_rendering_requires_claim_bundle"}},
        {"contains": {"const": "pre_scenario_registration_time_is_self_declared_not_independently_timestamped"}}
      ]
    }
  },
  "$defs": {
    "scenarioBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "scenario_record_sha256", "compilation_record_sha256"],
      "properties": {
        "scenario_id": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/stableId"},
        "scenario_record_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
        "compilation_record_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"}
      }
    },
    "guardrails": {
      "type": "object", "additionalProperties": false,
      "required": [
        "real_world_feasibility_claimed", "mechanism_support_claimed",
        "causal_attribution_performed", "forecast_performed",
        "probability_assigned", "recommendation_generated", "objective_optimized"
      ],
      "properties": {
        "real_world_feasibility_claimed": {"const": false},
        "mechanism_support_claimed": {"const": false},
        "causal_attribution_performed": {"const": false},
        "forecast_performed": {"const": false},
        "probability_assigned": {"const": false},
        "recommendation_generated": {"const": false},
        "objective_optimized": {"const": false}
      }
    }
  }
}
