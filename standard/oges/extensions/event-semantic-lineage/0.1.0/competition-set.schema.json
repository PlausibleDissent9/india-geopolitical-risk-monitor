{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://igrm.in/schemas/oges-event-semantic-lineage-competition-set-0.1.0.json",
  "title": "OGES Event Ledger computed CompetitionSet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "competition_set_id",
    "record_sha256",
    "predicate_id",
    "competition_sha256",
    "subject_event_component_sha256",
    "subject_event_component_status",
    "subject_event_refs",
    "competition_key_arguments",
    "positions",
    "relations",
    "proposition_denominator",
    "truth_selected"
  ],
  "properties": {
    "object_type": {"const": "competition_set"},
    "schema_version": {"const": "0.1.0"},
    "competition_set_id": {"type": "string", "pattern": "^cmp:[0-9a-f]{64}$"},
    "record_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
    "predicate_id": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/stableId"},
    "competition_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
    "subject_event_component_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
    "subject_event_component_status": {
      "enum": [
        "exact_event_identity",
        "normalized_lineage_identity",
        "ambiguous_split_ancestor",
        "distinct_split_branch"
      ]
    },
    "subject_event_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object_type", "object_id", "record_sha256"],
        "properties": {
          "object_type": {"const": "event"},
          "object_id": {"type": "string", "pattern": "^evt:[a-z0-9][a-z0-9._:-]{2,123}$"},
          "record_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"}
        }
      }
    },
    "competition_key_arguments": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "positions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["position_sha256", "stance", "ordered_arguments", "proposition_refs"],
        "properties": {
          "position_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
          "stance": {"enum": ["affirms", "denies", "questions"]},
          "ordered_arguments": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "proposition_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["proposition_id", "record_sha256"],
              "properties": {
                "proposition_id": {"type": "string", "pattern": "^prp:[a-z0-9][a-z0-9._:-]{2,123}$"},
                "record_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"}
              }
            }
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["left_position_sha256", "right_position_sha256", "relation", "opposition_rule_id"],
        "properties": {
          "left_position_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
          "right_position_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
          "relation": {"enum": ["registered_opposition", "divergence"]},
          "opposition_rule_id": {
            "oneOf": [
              {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/stableId"},
              {"type": "null"}
            ]
          }
        }
      }
    },
    "proposition_denominator": {"type": "integer", "minimum": 1},
    "truth_selected": {"const": false}
  }
}
