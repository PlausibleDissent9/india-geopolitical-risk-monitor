{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://igrm.in/schemas/oges-event-semantic-lineage-operation-0.1.0.json",
  "title": "OGES Event Ledger LineageOperation overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "operation_id",
    "record_sha256",
    "topology",
    "predecessors",
    "successors",
    "known_at",
    "valid_from",
    "reason_code",
    "basis_evidence_refs",
    "authorization",
    "unit_count_delta",
    "product_closure"
  ],
  "properties": {
    "object_type": {"const": "lineage_operation"},
    "schema_version": {"const": "0.1.0"},
    "operation_id": {"type": "string", "pattern": "^lin:[a-z0-9][a-z0-9._:-]{2,123}$"},
    "record_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
    "topology": {"enum": ["supersede", "merge", "split"]},
    "predecessors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lineageRef"}},
    "successors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lineageRef"}},
    "known_at": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/utcDateTime"},
    "valid_from": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/utcDateTime"},
    "reason_code": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/stableId"},
    "basis_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidenceRef"}
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_kind",
        "authority_id",
        "authority_role",
        "authority_registry_sha256",
        "signer_id",
        "statement_id",
        "payload_sha256",
        "statement_sha256",
        "trust_class",
        "signature_ed25519_base64"
      ],
      "properties": {
        "authority_kind": {"enum": ["human", "registered_deterministic_method", "model", "agent"]},
        "authority_id": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/stableId"},
        "authority_role": {"enum": ["lineage_coder", "lineage_adjudicator"]},
        "authority_registry_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
        "signer_id": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/stableId"},
        "statement_id": {"const": "statement:lineage_operation_authorization_v1"},
        "payload_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
        "statement_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"},
        "trust_class": {"const": "synthetic_nonproduction_public_test_vector"},
        "signature_ed25519_base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
      }
    },
    "unit_count_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "episode", "claim"],
      "properties": {
        "event": {"type": "integer"},
        "episode": {"type": "integer"},
        "claim": {"type": "integer"}
      }
    },
    "product_closure": {"$ref": "#/$defs/productClosure"}
  },
  "$defs": {
    "lineageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "object_id", "record_sha256"],
      "properties": {
        "object_type": {"enum": ["event", "episode", "claim"]},
        "object_id": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/stableId"},
        "record_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"}
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "object_id", "record_sha256"],
      "properties": {
        "object_type": {"const": "evidence_item"},
        "object_id": {"type": "string", "pattern": "^evd:[a-z0-9][a-z0-9._:-]{2,123}$"},
        "record_sha256": {"$ref": "https://igrm.in/schemas/common.schema.json#/$defs/sha256"}
      }
    },
    "productClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_code", "product_compilation_ref", "affected_manifest_ids"],
      "properties": {
        "status": {"const": "unavailable"},
        "reason_code": {"const": "product_compiler_contract_not_bound"},
        "product_compilation_ref": {"type": "null"},
        "affected_manifest_ids": {"type": "array", "maxItems": 0}
      }
    }
  }
}
